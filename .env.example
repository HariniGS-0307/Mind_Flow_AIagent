# REQUIRED on Vercel — set this in Vercel Dashboard → Settings → Environment Variables
# Users will NOT be asked for an API key when this is configured on the server
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: MongoDB Atlas connection string for saving history
# Example: mongodb+srv://user:password@cluster.mongodb.net/youtube-mindmaps
MONGODB_URI=your_mongodb_connection_string_here

# Local development port (not used on Vercel)
PORT=3002
