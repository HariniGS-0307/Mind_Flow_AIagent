# REQUIRED on Vercel — set in Vercel Dashboard → Settings → Environment Variables
# Get a NEW key at: https://aistudio.google.com/apikey
# Valid keys start with AIzaSy... OR AQ. (new format)
# Do NOT use placeholder/example keys — they will fail with "invalid authentication"
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: MongoDB Atlas connection string for saving history
# Example: mongodb+srv://user:password@cluster.mongodb.net/youtube-mindmaps
MONGODB_URI=your_mongodb_connection_string_here

# Local development port (not used on Vercel)
PORT=3002
